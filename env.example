# ==============================================================================
# 1. LOCAL DEVELOPMENT CONFIGURATION
# ==============================================================================
FLASK_APP=app.py
FLASK_DEBUG=1
SECRET_KEY=falsicode_super_secret_key_change_me_in_production
JWT_SECRET_KEY=falsicode_jwt_secret_key_change_me_in_production

# Local Database (Docker / Localhost)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=system_db
DB_USERNAME=root
DB_PASSWORD=rootpassword

# Local Frontend API URL
REACT_APP_API_URL=http://localhost:5000/api


# ==============================================================================
# 2. ONLINE CLOUD DEPLOYMENT CONFIGURATION (RENDER / AIVEN / VERCEL / GMAIL)
# ==============================================================================

# --- A. SET ON RENDER (Backend Environment Variables) ---
# Paste your full Aiven MySQL connection URI here:
# Example: mysql://avnadmin:AVNS_xxxx@mysql-xxxx.aivencloud.com:25060/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=your_aiven_mysql_service_uri_here

# Secret keys for Flask sessions and JWT authentication
SECRET_KEY=your_generated_random_secret_string
JWT_SECRET_KEY=your_generated_random_jwt_string

# Your Vercel frontend URL (without trailing slash) to allow CORS:
# Example: https://falsicode.vercel.app
CLIENT_URL=https://your-frontend.vercel.app

# Gmail SMTP for OTP Verification & Password Resets
# (Generate a 16-character Gmail App Password at: https://myaccount.google.com/apppasswords)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_digit_gmail_app_password


# --- B. SET ON VERCEL (Frontend Environment Variables) ---
# Your Render backend URL + /api (without trailing slash)
# Example: https://falsicode-backend.onrender.com/api
REACT_APP_API_URL=https://your-backend.onrender.com/api