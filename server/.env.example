# ==============================================================================
# FALSICODE ENGINE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- 1. Database Configuration (MySQL / PostgreSQL / SQLite) ---
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/system_db

# --- 2. Security Keys ---
SECRET_KEY=falsicode_super_secret_production_key_2026
JWT_SECRET_KEY=falsicode_super_jwt_secret_key_2026

# --- 3. Email & OTP Verification (Choose ONE method below) ---

# ==============================================================================
# OPTION A: Resend API (Recommended for Cloud Deployments like Render / Vercel)
# Free 3,000 emails/mo. Sign up at https://resend.com, create an API key.
# Uses HTTPS Port 443 (Never blocked by cloud hosts).
# ==============================================================================
RESEND_API_KEY=re_your_resend_api_key_here
MAIL_FROM=Falsicode <onboarding@resend.dev>

# ==============================================================================
# OPTION B: Gmail SMTP (Great for Localhost development)
# NOTE: Requires a 16-character Google "App Password" (NOT your regular password).
# How to get App Password:
# 1. Go to your Google Account > Security
# 2. Enable 2-Step Verification
# 3. Go to "App passwords" > Create name "Falsicode" > Copy the 16-character code
# ==============================================================================
# MAIL_USERNAME=your_gmail_address@gmail.com
# MAIL_PASSWORD=abcd efgh ijkl mnop
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ==============================================================================
# OPTION C: Brevo API (Alternative Cloud HTTPS API)
# Free 300 emails/day. Sign up at https://brevo.com
# ==============================================================================
# BREVO_API_KEY=your_brevo_api_key_here
# MAIL_USERNAME=your_verified_sender_email@domain.com
